# --- required ---
# Long random string; signs the session cookie.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
# Service account keys printed by `node erpnext/provision.js` (run with --rotate-keys to issue new ones)
ERP_API_KEY=
ERP_API_SECRET=
# Public URL of this app; printed into QR labels as <PUBLIC_URL>/s/<SKU>
PUBLIC_URL=https://ims.esmecrystal.com

# --- local development only (Docker sets ERP_URL=http://frontend:8080) ---
ERP_URL=http://localhost:8085

# --- optional ---
# ERP_COMPANY=Esme Crystal
# ERP_SELLING_PRICE_LIST=Standard Selling
# CORS_ORIGINS=            # only if the web app is served from another origin

# --- Shopify (optional) ---
# Dev Dashboard app in the same Shopify organisation as the store.
# Scopes: read_products, read_inventory, write_inventory, read_orders, read_locations
# SHOPIFY_SHOP=esme-crystal.myshopify.com
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# or a static Admin API token instead of client credentials:
# SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2026-10
# Pull Shopify orders every N minutes (0 = only when "Sync now" is pressed)
# SHOPIFY_SYNC_MINUTES=10
