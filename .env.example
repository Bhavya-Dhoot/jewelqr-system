# Root .env for docker-compose.prod.yml
IMS_DOMAIN=ims.esmecrystal.com
ERP_DOMAIN=erp.esmecrystal.com

# ERPNext. Change both passwords before the first `up`; they are baked into the site on creation.
ERP_ADMIN_PASSWORD=change-me-long-random
ERP_DB_ROOT_PASSWORD=change-me-long-random
# Keep ERPNext off the public interface; Caddy fronts it.
ERP_PORT=127.0.0.1:8085
ERP_COMPANY=Esme Crystal
ERP_COMPANY_ABBR=EC
