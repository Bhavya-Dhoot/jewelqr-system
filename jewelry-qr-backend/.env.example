# =============================================================================
# JewelQR Environment Configuration
# Copy to .env and fill in values
# =============================================================================

# MongoDB
MONGO_URI=mongodb://localhost:27017/jewelqr

# JWT — Generate secure secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins, or * for development)
CORS_ORIGIN=http://localhost:8000

# Rate Limiting (optional — sensible defaults built in)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX_REQUESTS=5

# Cookies (optional)
# COOKIE_SECRET=generate_a_secret
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax

# Logging
# LOG_LEVEL=info
